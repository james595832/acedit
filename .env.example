# Local MVP defaults AI/voice to stubs (no paid keys required).
USE_STUBS=true

# Optional — cheapest live providers when you are ready
# Anthropic: use Haiku (cheapest). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Deepgram free tier: https://console.deepgram.com
DEEPGRAM_API_KEY=

# Supabase free tier (Auth + DB): https://supabase.com/dashboard
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role — server only, never expose to the browser
SUPABASE_SERVICE_KEY=your-service-role-key

# Shared manual QA login (created by `npm run qa:ensure-user`; never commit real values)
# QA_TEST_EMAIL=qa-manual@acedit.app
# QA_TEST_PASSWORD=

# Canonical app origin (also used as Stripe return-URL allowlist)
# Must be allowed in Supabase Auth → URL Configuration → Redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated extra origins for Stripe return URLs (e.g. preview deploys)
# ALLOWED_APP_ORIGINS=https://your-app.vercel.app,https://preview.example.com

# Stripe (https://dashboard.stripe.com/test/apikeys)
# Create a Product + recurring Price, paste the price_… id
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID_PRO=price_...
# Required in production for cancel / payment-failure sync
# STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Blob (optional; local .data/uploads used when unset)
BLOB_READ_WRITE_TOKEN=
